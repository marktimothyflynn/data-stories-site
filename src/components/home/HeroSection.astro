<section class="min-h-[80vh] flex items-center pt-4xl">
  <div class="max-w-content-wide mx-auto px-lg grid grid-cols-1 lg:grid-cols-2 gap-2xl items-center">
    <!-- Problem statement -->
    <div>
      <h1 class="text-display text-text-primary mb-lg">
        Your data is there.<br />But you <span class="text-brand">can't see it.</span>
      </h1>
      <p class="text-body-large text-text-secondary max-w-content-text mb-xl">
        Every week, your team sends reports you don't read. Dashboards you don't check.
        Spreadsheets you can't decode. What if you could understand it all in 30 seconds?
      </p>
      <p class="text-small text-text-muted">Scroll to explore data stories &darr;</p>
    </div>

    <!-- Visual proof preview -->
    <div class="bg-surface-elevated border border-border rounded-2xl p-xl shadow-sm">
      <div class="flex items-center gap-sm mb-lg">
        <span class="text-caption uppercase tracking-widest text-brand font-semibold">Live data</span>
      </div>
      <!-- Placeholder viz — will be replaced with actual preview -->
      <div class="space-y-sm">
        <div class="flex items-end gap-xs h-48">
          <div class="flex-1 bg-brand/20 rounded-t" style="height: 65%"></div>
          <div class="flex-1 bg-brand/30 rounded-t" style="height: 45%"></div>
          <div class="flex-1 bg-brand/40 rounded-t" style="height: 80%"></div>
          <div class="flex-1 bg-brand/30 rounded-t" style="height: 35%"></div>
          <div class="flex-1 bg-brand rounded-t" style="height: 90%"></div>
          <div class="flex-1 bg-brand/40 rounded-t" style="height: 55%"></div>
          <div class="flex-1 bg-brand/30 rounded-t" style="height: 70%"></div>
          <div class="flex-1 bg-brand/20 rounded-t" style="height: 40%"></div>
        </div>
        <p class="text-caption text-text-muted">221,000 data points. One hidden pattern.</p>
      </div>
    </div>
  </div>
</section>
