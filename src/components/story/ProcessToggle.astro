---
interface Props {
  processSteps: string[];
}

const { processSteps } = Astro.props;
---

<div class="mt-xl">
  <button
    type="button"
    class="flex items-center gap-sm text-text-secondary hover:text-brand transition-colors duration-200 cursor-pointer group"
    aria-expanded="false"
    aria-controls="process-content"
    data-toggle="process"
  >
    <svg
      class="w-4 h-4 transition-transform duration-250 ease-out"
      data-chevron
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
    <span class="text-small font-medium">See how this was made</span>
  </button>

  <div
    id="process-content"
    class="overflow-hidden transition-all duration-250 ease-out"
    style="max-height: 0; opacity: 0;"
    aria-hidden="true"
    data-content
  >
    <ul class="mt-lg ml-lg space-y-sm">
      {processSteps.map((step) => (
        <li class="text-small text-text-secondary flex items-start gap-sm">
          <span class="text-brand mt-1 flex-shrink-0">&#8226;</span>
          <span>{step}</span>
        </li>
      ))}
    </ul>
  </div>
</div>

<script>
  document.querySelectorAll('[data-toggle="process"]').forEach((button) => {
    button.addEventListener('click', () => {
      const content = button.nextElementSibling as HTMLElement;
      const chevron = button.querySelector('[data-chevron]') as SVGElement;
      const isExpanded = button.getAttribute('aria-expanded') === 'true';

      button.setAttribute('aria-expanded', String(!isExpanded));
      content.setAttribute('aria-hidden', String(isExpanded));

      if (!isExpanded) {
        content.style.maxHeight = content.scrollHeight + 'px';
        content.style.opacity = '1';
        chevron.style.transform = 'rotate(180deg)';
      } else {
        content.style.maxHeight = '0';
        content.style.opacity = '0';
        chevron.style.transform = 'rotate(0deg)';
      }
    });
  });
</script>
