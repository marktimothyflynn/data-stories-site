---
interface Props {
  dashboardPath: string;
  fallbackImage: string;
  accessibleSummary: string;
  title: string;
}

const { dashboardPath, fallbackImage, accessibleSummary, title } = Astro.props;
---

<div class="w-full" role="img" aria-label={accessibleSummary}>
  <div class="bg-surface-elevated border border-border rounded-2xl overflow-hidden shadow-sm">
    <!-- Dashboard iframe -->
    <div class="relative w-full" style="min-height: 400px;">
      <iframe
        src={dashboardPath}
        title={`Interactive dashboard: ${title}`}
        class="w-full border-0"
        style="min-height: 400px;"
        loading="lazy"
      ></iframe>
    </div>
  </div>
  <!-- Accessible text summary (visually hidden) -->
  <p class="sr-only">{accessibleSummary}</p>
</div>
