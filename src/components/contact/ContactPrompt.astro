---
interface Props {
  ctaText?: string;
  storyName?: string;
}

const { ctaText = 'Have a data problem like this?', storyName } = Astro.props;
const prefillMessage = storyName ? `I was looking at "${storyName}" and ` : '';
---

<div class="mt-xl" id="contact">
  <!-- CTA prompt -->
  <div data-contact-prompt>
    <p class="text-body-large text-text-secondary mb-lg">{ctaText}</p>
    <button
      type="button"
      class="inline-block px-xl py-md bg-brand text-white rounded-lg font-semibold hover:bg-brand-dark transition-colors duration-200 cursor-pointer"
      data-contact-trigger
    >
      Get in touch
    </button>
  </div>

  <!-- Contact form (hidden by default) -->
  <div class="hidden" data-contact-form>
    <p class="text-body-large text-text-secondary mb-lg">{ctaText}</p>
    <form class="space-y-md max-w-content-text" data-form>
      <div>
        <label for="contact-name" class="block text-small font-medium text-text-primary mb-xs">Name</label>
        <input
          type="text"
          id="contact-name"
          name="name"
          required
          aria-required="true"
          class="w-full px-md py-sm border border-border rounded-lg bg-surface-elevated text-text-primary focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20 transition-colors"
        />
        <p class="text-caption text-error mt-xs hidden" data-error="name"></p>
      </div>

      <div>
        <label for="contact-email" class="block text-small font-medium text-text-primary mb-xs">Email</label>
        <input
          type="email"
          id="contact-email"
          name="email"
          required
          aria-required="true"
          class="w-full px-md py-sm border border-border rounded-lg bg-surface-elevated text-text-primary focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20 transition-colors"
        />
        <p class="text-caption text-error mt-xs hidden" data-error="email"></p>
      </div>

      <div>
        <label for="contact-message" class="block text-small font-medium text-text-primary mb-xs">Message</label>
        <textarea
          id="contact-message"
          name="message"
          rows="4"
          required
          aria-required="true"
          placeholder="Tell me about your data problem..."
          class="w-full px-md py-sm border border-border rounded-lg bg-surface-elevated text-text-primary focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20 transition-colors resize-y"
        >{prefillMessage}</textarea>
        <p class="text-caption text-error mt-xs hidden" data-error="message"></p>
      </div>

      <!-- Honeypot -->
      <div class="hidden" aria-hidden="true">
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <button
        type="submit"
        class="px-xl py-md bg-brand text-white rounded-lg font-semibold hover:bg-brand-dark transition-colors duration-200 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
        data-submit
      >
        Send message
      </button>
    </form>
  </div>

  <!-- Success message (hidden by default) -->
  <div class="hidden" data-contact-success aria-live="polite">
    <div class="bg-brand-light border border-brand/20 rounded-lg p-xl">
      <p class="text-body text-text-primary font-medium">Thanks — I'll be in touch within a day or two.</p>
    </div>
  </div>
</div>

<script>
  const trigger = document.querySelector('[data-contact-trigger]') as HTMLButtonElement;
  const prompt = document.querySelector('[data-contact-prompt]') as HTMLElement;
  const formContainer = document.querySelector('[data-contact-form]') as HTMLElement;
  const successContainer = document.querySelector('[data-contact-success]') as HTMLElement;
  const form = document.querySelector('[data-form]') as HTMLFormElement;
  const submitBtn = document.querySelector('[data-submit]') as HTMLButtonElement;

  if (trigger && form) {
    trigger.addEventListener('click', () => {
      prompt.classList.add('hidden');
      formContainer.classList.remove('hidden');
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Clear previous errors
      form.querySelectorAll('[data-error]').forEach((el) => el.classList.add('hidden'));

      const formData = new FormData(form);
      const data = {
        name: formData.get('name') as string,
        email: formData.get('email') as string,
        message: formData.get('message') as string,
        website: formData.get('website') as string, // honeypot
      };

      // Client-side validation
      let hasErrors = false;
      if (!data.name?.trim()) {
        showError('name', 'Please enter your name');
        hasErrors = true;
      }
      if (!data.email?.trim() || !data.email.includes('@')) {
        showError('email', 'Please enter a valid email address');
        hasErrors = true;
      }
      if (!data.message?.trim() || data.message.trim().length < 10) {
        showError('message', 'Please tell me a bit more (at least 10 characters)');
        hasErrors = true;
      }
      if (hasErrors) return;

      // Submit
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const result = await response.json();

        if (result.success) {
          formContainer.classList.add('hidden');
          successContainer.classList.remove('hidden');
        } else if (result.errors) {
          Object.entries(result.errors).forEach(([field, message]) => {
            showError(field, message as string);
          });
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send message';
        } else {
          showError('message', result.message || 'Something went wrong — please try again');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send message';
        }
      } catch {
        showError('message', 'Something went wrong — please try again');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send message';
      }
    });
  }

  function showError(field: string, message: string) {
    const el = document.querySelector(`[data-error="${field}"]`) as HTMLElement;
    if (el) {
      el.textContent = message;
      el.classList.remove('hidden');
      const input = document.querySelector(`[name="${field}"]`) as HTMLElement;
      if (input) input.setAttribute('aria-describedby', el.id || `error-${field}`);
    }
  }
</script>
