---
import '../styles/global.css';
import SiteHeader from '../components/layout/SiteHeader.astro';
import PageFooter from '../components/layout/PageFooter.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Data Stories — See your data clearly',
  description = 'Interactive data stories that make complex business problems immediately clear.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-surface text-text-primary font-sans text-body min-h-screen">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-brand focus:text-white focus:px-4 focus:py-2 focus:rounded">
      Skip to main content
    </a>

    <SiteHeader />

    <main id="main-content" role="main">
      <slot />
    </main>

    <PageFooter />
  </body>
</html>
